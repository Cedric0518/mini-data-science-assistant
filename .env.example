# Copy this file to .env and fill it in. Never commit .env.

# local = Gemma through Ollama (no account needed), foundry = Microsoft Foundry
BACKEND=local

# Only needed when BACKEND=foundry
FOUNDRY_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=gpt-4.1-mini